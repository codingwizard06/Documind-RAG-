# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real API keys.

# --- LLM provider: "anthropic", "openai", or "none" (retrieval-only mode) ---
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Generation ---
MAX_TOKENS=800
TEMPERATURE=0.1

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Retrieval ---
TOP_K=4
USE_RERANKER=true
RERANK_TOP_N=10

# --- Embeddings ---
EMBEDDING_DEVICE=cpu
